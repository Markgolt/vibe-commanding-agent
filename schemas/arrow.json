{
    "name": "Arrow",
    "description": "A directional arrow entity representing movement or direction",
    "fields": {
        "id": {
            "type": "string",
            "required": true,
            "description": "Unique identifier for the arrow"
        },
        "location": {
            "type": "object",
            "required": true,
            "description": "Current location of the arrow",
            "properties": [
                {
                    "lat": {
                        "type": "number",
                        "required": true
                    },
                    "lon": {
                        "type": "number",
                        "required": true
                    }
                }
            ]
        },
        "type": {
            "type": "string",
            "required": true,
            "description": "Type of arrow",
            "enum": [
                "movement",
                "attack",
                "retreat",
                "other"
            ]
        },
        "description": {
            "type": "string",
            "required": false,
            "description": "Additional description of the arrow's purpose"
        },
        "executingUnitId": {
            "type": "string",
            "required": false,
            "description": "ID of the unit executing the action"
        },
        "createdBy": {
            "type": "string",
            "required": false,
            "description": "ID of the user who created the arrow"
        },
        "updatedBy": {
            "type": "string",
            "required": false,
            "description": "ID of the user who last updated the arrow"
        },
        "created_at": {
            "type": "string",
            "required": true,
            "description": "Timestamp of arrow creation",
            "format": "date-time"
        },
        "updated_at": {
            "type": "string",
            "required": true,
            "description": "Timestamp of last update",
            "format": "date-time"
        }
    }
}
